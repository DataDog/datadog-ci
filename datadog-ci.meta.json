{
  "plugins": {
    "@datadog/datadog-ci-plugin-lambda": {
      "bundle": {
        "extraBundlePatterns": [
          "./src/functions/*.ts"
        ],
        "extraBundleExternalPatterns": [
          "@aws-sdk/",
          "@smithy/"
        ]
      }
    },
    "@datadog/datadog-ci-plugin-auth": {
      "bundle": {
        "externalPatterns": [
          "@napi-rs/keyring"
        ]
      }
    }
  }
}
